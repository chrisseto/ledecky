{
  "name": "ledecky-web",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node web/scripts/icons.mjs",
    "build": "pnpm icons && esbuild web/src/app.js --bundle --minify --format=iife --outfile=static/app.js && esbuild web/src/app.css --bundle --minify --loader:.woff2=file --outfile=static/app.css",
    "watch": "pnpm icons && esbuild web/src/app.js web/src/app.css --bundle --sourcemap --format=iife --loader:.woff2=file --outdir=static --watch",
    "e2e": "playwright test --project=chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:trace": "E2E_DEBUG=1 playwright test --project=chromium --retries=1 --trace=on",
    "e2e:shots": "playwright test --project=shots",
    "e2e:perf": "playwright test --project=perf --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "htmx.org": "4.0.0",
    "lucide-static": "^0.563.0",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
